{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "outDir": "api-dist",
    "verbatimModuleSyntax": true
  },
  "include": ["api/**/*.ts", "src/server/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/components", "src/views", "src/stores", "src/router", "src/assets"]
}
